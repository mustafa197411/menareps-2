{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "test": "vitest run",
    "test:standalone:auth-activation": "tsx src/auth_activation_claim.test.ts",
    "test:hierarchy": "tsx src/hierarchyService.test.ts",
    "test:hierarchy-backend": "tsx server/organizationalHierarchyService.test.ts",
    "test:hierarchy-rules": "tsx src/hierarchyRules.test.ts",
    "validate:production-readiness": "tsx server/productionReadinessCli.ts",
    "configure:offers-registry": "tsx server/offersRegistryConfigurationCli.ts",
    "uat:emulator:app": "tsx server.ts",
    "uat:emulator:preflight": "tsx tests/uat/emulator/preflight.ts",
    "uat:emulator:seed": "tsx tests/uat/emulator/seed.ts",
    "uat:emulator:reset": "tsx tests/uat/emulator/reset.ts",
    "uat:emulator:rules": "vitest run --config vitest.uat.config.ts",
    "uat:emulator:navigation": "playwright test --config playwright.uat.config.ts navigation.spec.ts settingsVisibility.spec.ts authPersistence.spec.ts",
    "uat:emulator:scope": "vitest run --config vitest.uat.config.ts tests/uat/emulator/firestoreSecurity.test.ts tests/uat/emulator/routeAuthorization.test.ts",
    "uat:emulator:storage": "vitest run --config vitest.uat.config.ts tests/uat/emulator/storageSecurity.test.ts",
    "uat:emulator:identity-audit": "vitest run tests/uat/emulator/noIdentityAllowlist.test.ts tests/uat/emulator/firebaseEmulatorGuard.test.ts tests/uat/emulator/routeAuthorization.test.ts",
    "uat:emulator:certify": "tsx tests/uat/emulator/certify.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "15.21.0",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
